# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything has a working local default except
# ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------

# --- Claude (required) -----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used to answer questions.
#   claude-sonnet-5    $3 / $15 per 1M tokens  (default)
#   claude-haiku-4-5   $1 / $5   per 1M tokens (cheapest)
#   claude-opus-5      $5 / $25  per 1M tokens (hardest reasoning)
PUK_CLAUDE_MODEL=claude-sonnet-5
PUK_CLAUDE_EFFORT=low
PUK_CLAUDE_MAX_TOKENS=2000

# --- Database (required) ---------------------------------------------------
# Postgres with the pgvector extension. Neon connection strings work as-is,
# but change the driver prefix to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/kicks_dev

# --- Auth ------------------------------------------------------------------
# dev   = no sign-in, every request is DEV_USER_ID (local only)
# clerk = verify real Clerk session tokens
AUTH_MODE=dev
DEV_USER_ID=dev_user
DEV_USER_EMAIL=dev@localhost
# CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-app>.clerk.accounts.dev

# --- Storage ---------------------------------------------------------------
# local = server/data/uploads
# r2    = presigned uploads straight to Cloudflare R2
STORAGE_BACKEND=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kicks-lectures

# --- Transcription ---------------------------------------------------------
# local = Whisper in a subprocess (needs requirements-local.txt)
# modal = serverless GPU worker (modal deploy modal_app.py)
TRANSCRIBE_BACKEND=local
MODAL_APP_NAME=kicks-transcribe
WHISPER_MODEL_SIZE=base

# --- Quotas ----------------------------------------------------------------
# Monthly Claude spend ceiling per user, in USD.
FREE_PLAN_MONTHLY_USD=1.00
PRO_PLAN_MONTHLY_USD=20.00

# --- Subjects --------------------------------------------------------------
MAX_WORKSPACES_PER_USER=50
# Indexed passages per account (lectures and imported course material).
FREE_PLAN_MAX_CHUNKS=10000
PRO_PLAN_MAX_CHUNKS=100000

# --- Canvas ----------------------------------------------------------------
# One developer key per school, issued by that school's Canvas admin. See
# docs/SETUP.md, "Canvas", for what the admin has to create. JSON, one line:
# CANVAS_OAUTH_CLIENTS={"https://canvas.example.edu": {"client_id": "...", "client_secret": "..."}}
CANVAS_OAUTH_CLIENTS=
# Encrypts stored Canvas tokens. Required with AUTH_MODE=clerk. Comma separated
# to rotate: the first key encrypts, all of them decrypt. Generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CANVAS_TOKEN_KEY=
# Local testing only: connect with a personal access token instead of OAuth.
# Refused with AUTH_MODE=clerk.
CANVAS_ALLOW_PERSONAL_TOKENS=false
CANVAS_MAX_FILE_BYTES=52428800
# Where browsers reach this API and the web app. The OAuth redirect URI is
# PUBLIC_API_URL + /api/canvas/oauth/callback.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000

# --- Tests -----------------------------------------------------------------
# Database the server tests create and empty. Never point it at real data.
# TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/kicks_test

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# Signs playback URLs. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Must be set in production — the default lets anyone mint a playback link.
SECRET_KEY=dev-insecure-change-me

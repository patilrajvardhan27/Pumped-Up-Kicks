# Copy to .env.local. Only NEXT_PUBLIC_ variables are read here, and every one of
# them is visible in the browser: never put a secret in this file.

# API origin. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The public address of this site. Used for canonical links, the sitemap and
# social previews, so set it to the real https:// address in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign-in. Leave empty to run in local dev mode (no sign-in).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Product analytics. Leave the token empty to switch analytics and the cookie
# banner off. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shown on the privacy policy and terms. Set both before launch.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: extra origins lecture files are uploaded to or played from (space separated).
NEXT_PUBLIC_STORAGE_ORIGINS=
